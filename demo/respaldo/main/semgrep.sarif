{"version":"2.1.0","runs":[{"invocations":[{"executionSuccessful":true,"toolExecutionNotifications":[]}],"results":[{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"app/src/server.js","uriBaseId":"%SRCROOT%"},"region":{"endColumn":89,"endLine":13,"snippet":{"text":"  const rows = db.prepare(\"SELECT id, name, email FROM users WHERE id = \" + req.query.id).all();"},"startColumn":77,"startLine":13}}}],"message":{"text":"Detected user input used to manually construct a SQL string. This is usually bad practice because manual construction could accidentally result in a SQL injection. An attacker could use a SQL injection to steal or modify contents of the database. Instead, use a parameterized query which is available by default in most database engines. Alternatively, consider using an object-relational mapper (ORM) such as Sequelize which will protect your queries."},"properties":{},"ruleId":"javascript.express.security.injection.tainted-sql-string.tainted-sql-string"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"app/src/server.js","uriBaseId":"%SRCROOT%"},"region":{"endColumn":5,"endLine":23,"snippet":{"text":"  exec(`ping -c 1 ${req.query.host}`, (err, stdout) => {\n    if (err) return res.status(500).send(\"error\");\n    res.type(\"text\").send(stdout);\n  });"},"startColumn":3,"startLine":20}}}],"message":{"text":"User controlled data in 'child_process.exec()' can result in Remote OS Command Execution."},"properties":{},"ruleId":"ajinabraham.njsscan.exec.exec_os_command.generic_os_command_exec"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"app/src/server.js","uriBaseId":"%SRCROOT%"},"region":{"endColumn":37,"endLine":29,"snippet":{"text":"  const result = eval(req.body.expr);"},"startColumn":18,"startLine":29}}}],"message":{"text":"User controlled data in eval() or similar functions may result in Server Side Injection or Remote Code Injection"},"properties":{},"ruleId":"ajinabraham.njsscan.eval.eval_node.eval_nodejs"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"app/src/server.js","uriBaseId":"%SRCROOT%"},"region":{"endColumn":37,"endLine":29,"snippet":{"text":"  const result = eval(req.body.expr);"},"startColumn":18,"startLine":29}}}],"message":{"text":"Found data from an Express or Next web request flowing to `eval`. If this data is user-controllable this can lead to execution of arbitrary system commands in the context of your application process. Avoid `eval` whenever possible."},"properties":{},"ruleId":"javascript.lang.security.audit.code-string-concat.code-string-concat"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"app/src/server.js","uriBaseId":"%SRCROOT%"},"region":{"endColumn":57,"endLine":36,"snippet":{"text":"  res.send(tpl({ name: req.query.name || \"V-SandBox\" }));"},"startColumn":3,"startLine":36}}}],"message":{"text":"Untrusted User Input in Response will result in Reflected Cross Site Scripting Vulnerability."},"properties":{},"ruleId":"ajinabraham.njsscan.xss.xss_node.express_xss"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"app/src/server.js","uriBaseId":"%SRCROOT%"},"region":{"endColumn":56,"endLine":36,"snippet":{"text":"  res.send(tpl({ name: req.query.name || \"V-SandBox\" }));"},"startColumn":12,"startLine":36}}}],"message":{"text":"Detected directly writing to a Response object from user-defined input. This bypasses any HTML escaping and may expose your application to a Cross-Site-scripting (XSS) vulnerability. Instead, use 'resp.render()' to render safely escaped HTML."},"properties":{},"ruleId":"javascript.express.security.audit.xss.direct-response-write.direct-response-write"}],"tool":{"drive